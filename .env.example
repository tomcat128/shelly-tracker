# Shelly Cloud (Shelly App -> Benutzereinstellungen -> Authorization cloud key)
SHELLY_HOST=shelly-XX-eu.shelly.cloud
SHELLY_AUTH_KEY=change-me
# v2 (empfohlen, bis zu 10 Geräte pro Request) oder v1 (veraltet, ein Request pro Gerät)
SHELLY_API_VERSION=v2

# Abrufintervall in Sekunden (Cloud-Limit: 1 Request/Sekunde)
POLL_INTERVAL_SECONDS=60

# Datenbank (Standard: SQLite im Volume /data)
DATABASE_URL=sqlite:////data/shelly.db
# MariaDB/MySQL: DATABASE_URL=mysql+pymysql://shelly:secret@db:3306/shelly

# Zeitzone für Ausgaben und für Zeitangaben ohne Zone im Export
TIMEZONE=Europe/Berlin

# Wenn gesetzt, verlangt die API "Authorization: Bearer <token>", "X-API-Key: <token>" oder ?token=<token>
API_TOKEN=

# Minutenwerte so viele Monate aufbewahren, danach bleiben nur Stundenwerte
# (Mittel/Min/Max pro Stunde). Leer = 18 Monate, 0 = Minutenwerte nie löschen.
RAW_RETENTION_MONTHS=18

# Komplettes Roh-JSON jeder Messung zusätzlich speichern (braucht mehr Platz)
STORE_RAW=false
# Messung nicht speichern, wenn sich nichts geändert hat (nur relevant ohne Geräte-Zeitstempel)
SKIP_UNCHANGED=true

LOG_LEVEL=INFO
HOST_PORT=9090

# UID/GID, denen die Dateien in ./data gehören sollen (Ausgabe von "id -u" / "id -g")
PUID=1000
PGID=1000
